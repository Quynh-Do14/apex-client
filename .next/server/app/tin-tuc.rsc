b:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"APEX AUTO | Trung Tâm Phụ Kiện, Đồ Chơi Ô Tô Cao Cấp Bình Dương"}],["$","meta","3",{"name":"description","content":"APEX AUTO là trung tâm phụ kiện, đồ chơi và chăm sóc ô tô cao cấp tại Thủ Dầu Một, Bình Dương. Chúng tôi chuyên cung cấp và lắp đặt màn hình Android, Android Box, camera hành trình, camera 360, phim cách nhiệt, PPF bảo vệ sơn, nâng cấp ánh sáng và các giải pháp chăm sóc xe chuyên sâu.\n\nVới đội ngũ kỹ thuật viên giàu kinh nghiệm, quy trình thi công chỉn chu cùng chính sách bảo hành rõ ràng, APEX AUTO luôn hướng đến mục tiêu mang lại sự hài lòng tối đa cho khách hàng. Mỗi sản phẩm và dịch vụ đều được lựa chọn kỹ lưỡng nhằm giúp chiếc xe vận hành an toàn hơn, tiện nghi hơn và giữ được giá trị bền vững theo thời gian.\n\nKhông chỉ là nơi nâng cấp xe, APEX AUTO mong muốn trở thành người đồng hành đáng tin cậy của cộng đồng chủ xe tại Bình Dương và khu vực lân cận."}],["$","meta","4",{"name":"author","content":"Công ty TNHH Apex Auto"}],["$","meta","5",{"name":"keywords","content":"Apexauto, Apex auto, Apex auto Thành phố Hồ Chí Minh, Apexauto Thành phố Hồ Chí Minh, Đại sứ Zestech Số 1 Bình Dương, Zestech, 3M, Inmax, Màn hình android, Android box, Lắp đặt màn hình Zestech, Lắp màn android tại Thành phố Hồ Chí Minh, Lắp màn Zestech tại Thành phố Hồ Chí Minh, Độ xe điện, Lắp ốp pin xe điện ở đâu, Lắp ốp pin xe Vinfast"}],["$","meta","6",{"name":"robots","content":"index, follow"}],["$","meta","7",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","8",{"rel":"canonical","href":"https://apexauto.vn"}],["$","meta","9",{"property":"og:title","content":"APEX AUTO | Trung Tâm Phụ Kiện, Đồ Chơi Ô Tô Cao Cấp Bình Dương"}],["$","meta","10",{"property":"og:description","content":"APEX AUTO là trung tâm phụ kiện, đồ chơi và chăm sóc ô tô cao cấp tại Thủ Dầu Một, Bình Dương. Chúng tôi chuyên cung cấp và lắp đặt màn hình Android, Android Box, camera hành trình, camera 360, phim cách nhiệt, PPF bảo vệ sơn, nâng cấp ánh sáng và các giải pháp chăm sóc xe chuyên sâu.\n\nVới đội ngũ kỹ thuật viên giàu kinh nghiệm, quy trình thi công chỉn chu cùng chính sách bảo hành rõ ràng, APEX AUTO luôn hướng đến mục tiêu mang lại sự hài lòng tối đa cho khách hàng. Mỗi sản phẩm và dịch vụ đều được lựa chọn kỹ lưỡng nhằm giúp chiếc xe vận hành an toàn hơn, tiện nghi hơn và giữ được giá trị bền vững theo thời gian.\n\nKhông chỉ là nơi nâng cấp xe, APEX AUTO mong muốn trở thành người đồng hành đáng tin cậy của cộng đồng chủ xe tại Bình Dương và khu vực lân cận."}],["$","meta","11",{"property":"og:url","content":"https://apexauto.vn"}],["$","meta","12",{"property":"og:site_name","content":"Apex Auto Thành phố Hồ Chí Minh"}],["$","meta","13",{"property":"og:image","content":"https://api.apexauto.vn/api/uploads/apex-auto-logo.png"}],["$","meta","14",{"property":"og:image:alt","content":"Apex Auto Thành phố Hồ Chí Minh - Phụ kiện ô tô cao cấp"}],["$","meta","15",{"property":"og:type","content":"website"}],["$","meta","16",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","17",{"name":"twitter:title","content":"APEX AUTO | Trung Tâm Phụ Kiện, Đồ Chơi Ô Tô Cao Cấp Bình Dương"}],["$","meta","18",{"name":"twitter:description","content":"APEX AUTO là trung tâm phụ kiện, đồ chơi và chăm sóc ô tô cao cấp tại Thủ Dầu Một, Bình Dương. Chúng tôi chuyên cung cấp và lắp đặt màn hình Android, Android Box, camera hành trình, camera 360, phim cách nhiệt, PPF bảo vệ sơn, nâng cấp ánh sáng và các giải pháp chăm sóc xe chuyên sâu.\n\nVới đội ngũ kỹ thuật viên giàu kinh nghiệm, quy trình thi công chỉn chu cùng chính sách bảo hành rõ ràng, APEX AUTO luôn hướng đến mục tiêu mang lại sự hài lòng tối đa cho khách hàng. Mỗi sản phẩm và dịch vụ đều được lựa chọn kỹ lưỡng nhằm giúp chiếc xe vận hành an toàn hơn, tiện nghi hơn và giữ được giá trị bền vững theo thời gian.\n\nKhông chỉ là nơi nâng cấp xe, APEX AUTO mong muốn trở thành người đồng hành đáng tin cậy của cộng đồng chủ xe tại Bình Dương và khu vực lân cận."}],["$","meta","19",{"name":"twitter:image","content":"https://api.apexauto.vn/api/uploads/apex-auto-logo.png"}],["$","link","20",{"rel":"icon","href":"/favicon.ico","type":"image/x-icon","sizes":"16x16"}]]
